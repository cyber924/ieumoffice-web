rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The designated administrator has access to all Storage objects.
    match /{path=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'cyber924@naver.com';
    }
    match /user-files/{userId}/{docId}/{fileName} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validFile() {
        return request.resource != null
          && request.resource.size <= 15 * 1024 * 1024
          && request.resource.contentType in [
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/octet-stream'
          ]
          && fileName.matches('.*\\.(docx|hwpx)');
      }
      allow read: if owner();
      allow create, update: if owner() && validFile();
      allow delete: if owner();
    }
  }
}
