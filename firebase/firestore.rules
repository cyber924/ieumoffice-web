rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/documents/{documentId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validDocument() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'kind', 'path', 'size', 'updatedAt'])
          && d.keys().hasAll(['name', 'kind', 'path', 'size', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 150
          && d.kind in ['docx', 'hwpx']
          && d.size is int && d.size >= 0 && d.size <= 15 * 1024 * 1024
          && d.updatedAt is timestamp && d.path is string
          && d.path.matches('^user-files/' + userId + '/' + documentId + '/[^/]+$');
      }
      allow read: if owner();
      allow create, update: if owner() && validDocument();
      allow delete: if owner();
    }
  }
}
